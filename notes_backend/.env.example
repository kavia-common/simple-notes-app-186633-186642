# Notes Backend Environment Variables

# Port for the Express server (default: 4000)
PORT=4000

# Frontend origin allowed by CORS (e.g., http://localhost:3000)
# Use * to allow all origins (not recommended in production)
FRONTEND_URL=http://localhost:3000

# Request logging level for morgan (e.g., tiny, dev, combined)
LOG_LEVEL=tiny

# Healthcheck path; override if you want a different endpoint than /health
HEALTHCHECK_PATH=/health
